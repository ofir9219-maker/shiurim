# --- Embeddings / chat (all optional; the site works with full-text search only) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=512
CHAT_MODEL=gpt-4.1-mini
# CHAT_MODELS=gpt-4.1-mini,gpt-5-mini,o4-mini   (optional allowlist for the chat model selector; default: list from OpenAI /models)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Audio storage (optional; without these audio is proxied from Google Drive via /api/audio/[id]) ---
R2_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Drive sync (npm run sync) ---
DRIVE_FOLDER_ID=1qjOmvVykyiYnODxTdUEnBqiNgQkqgUp5
GOOGLE_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=   (inline JSON or path to key file)

# DB_PATH=data/shiurim.db

# --- Automatic ingestion + Drive center (docs/DRIVE-CENTER.md) ---
# STORAGE_DIR=/data                 # Railway volume mount (default ./storage); DB goes to $STORAGE_DIR/shiurim.db
# ADMIN_PASSWORD=                   # protects /admin
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FAL_KEY=
# POLISH_MODEL=gpt-5.2
# POLISH_EFFORT=medium
# INGEST_POLL_MINUTES=10
# INGEST_ENABLED=1                  # 0 disables the scheduler
# PUBLIC_BASE_URL=https://web-production-50ad5c1f.up.railway.app
